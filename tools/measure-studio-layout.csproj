<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Measures the Luma Studio page's two columns and reports the height difference,
       so a layout imbalance is a number instead of an impression. Classic project,
       matching the app: this machine's MSBuild has no .NET SDK resolver. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ProjectGuid>{7D3E9A14-2C58-4B60-A7E1-9F4D2C8B3A55}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>MeasureStudioLayout</RootNamespace>
    <AssemblyName>MeasureStudioLayout</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\</OutputPath>
    <StartupObject>MeasureStudioLayout</StartupObject>
    <LangVersion>7.3</LangVersion>
    <FrameworkPathOverride Condition=" '$(FrameworkPathOverride)' == '' ">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="MeasureStudioLayout.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

</Project>
